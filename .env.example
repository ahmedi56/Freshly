# ---- Backend (backend/.env) ----
# Copy to backend/.env
PORT=3001
NODE_ENV=development
# Required. Must be a random string of at least 32 characters. The server
# refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Comma-separated allowed origins. Web app + Expo web dev servers.
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006

# ---- Web app (apps/customer-web/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ---- Mobile app (apps/cleaner-mobile/.env) ----
# For a physical device, replace localhost with your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3001/api

